# 开发环境配置
VITE_APP_TITLE=Mall 后台管理系统
# 浏览器请求前缀，会被 Vite Server 代理到 VITE_API_TARGET
VITE_APP_BASE_API=/api
# Vite 开发服务器代理目标（mall-admin 服务地址）
VITE_API_TARGET=http://localhost:8090
# product 模块开发代理目标
VITE_PRODUCT_API_TARGET=http://localhost:11000
# ware 模块开发代理目标
VITE_WARE_API_TARGET=http://localhost:12000
